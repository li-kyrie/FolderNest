<UserControl x:Class="FolderNest.Desktop.Controls.DayStepper"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FolderNest.Desktop.Controls"
 x:Name="Root">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
    <TextBox x:Name="Editor" VerticalContentAlignment="Center" PreviewKeyDown="OnKeyDown" LostKeyboardFocus="OnLostFocus" AutomationProperties.Name="保留天数">
      <TextBox.Text>
        <Binding Path="Value" ElementName="Root" Mode="OneWay"/>
      </TextBox.Text>
    </TextBox>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <Button Content="▴" Padding="0" Margin="0" Click="Increase" Focusable="False" AutomationProperties.Name="天数增加 1"/>
      <Button Grid.Row="1" Content="▾" Padding="0" Margin="0" Click="Decrease" Focusable="False" AutomationProperties.Name="天数减少 1"/>
    </Grid>
  </Grid>
</UserControl>
