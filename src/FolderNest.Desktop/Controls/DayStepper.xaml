<UserControl x:Class="FolderNest.Desktop.Controls.DayStepper"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FolderNest.Desktop.Controls"
 x:Name="Root">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
    <TextBox VerticalContentAlignment="Center" PreviewKeyDown="OnKeyDown">
      <TextBox.Text>
        <Binding Path="Value" ElementName="Root" UpdateSourceTrigger="LostFocus" ValidatesOnExceptions="True" NotifyOnValidationError="True">
          <Binding.ValidationRules><local:IntegerDaysRule/></Binding.ValidationRules>
        </Binding>
      </TextBox.Text>
    </TextBox>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      <Button Content="▴" Padding="0" Margin="0" Click="Increase" Focusable="False"/>
      <Button Grid.Row="1" Content="▾" Padding="0" Margin="0" Click="Decrease" Focusable="False"/>
    </Grid>
  </Grid>
</UserControl>
