<Window x:Class="FolderNest.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:FolderNest.Desktop.Controls"
 Title="FolderNest · 2.1.0" Width="1100" Height="660" MinWidth="760" MinHeight="480"
 Icon="Assets/FolderNest.ico" ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="FolderNest" FontSize="22" FontWeight="SemiBold" Margin="3,0,3,4"/>
   <TextBlock Text="监控计时：目录加入监控开始计时，修改文件刷新时间" Margin="3,3" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding BackgroundText}" Margin="3,3" TextWrapping="Wrap"/>
   <WrapPanel Margin="0,4,0,8" IsEnabled="{Binding IsIdle}">
    <Button Content="添加监控目录" Click="Add_Click"/>
    <Button Content="启用/停用选中" Click="Toggle_Click"/>
    <Button Content="删除监控任务" Click="Remove_Click"/>
    <Button Content="重置计时" Click="Reset_Click"/>
    <Button Content="扫描选中" Click="ScanSelected_Click"/>
    <Button Content="扫描全部启用" Click="ScanAll_Click"/>
    <Button Content="查看到期清单" Click="Review_Click"/>
    <Button Content="设置" Click="Settings_Click"/>
    <Button Content="导入旧版配置" Click="Import_Click"/>
    <Button Content="查看日志" Click="Log_Click"/>
    <Button Content="退出程序" Click="Exit_Click"/>
   </WrapPanel>
   <TextBlock Text="Ctrl 多选 · Shift 范围选择。拖动左侧排序柄调整顺序；双击路径编辑。停用保留计时，删除后重新添加会重新计时。"
    Foreground="#555555" Margin="3,0,3,6" TextWrapping="Wrap"/>
   <DockPanel IsEnabled="{Binding IsIdle}" Margin="0,0,0,4">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Content="全选" Click="SelectAll_Click"/>
     <Button Content="全不选" Click="SelectNone_Click"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="监控目录" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3,0,12,0"/>
     <Button Content="上移" Click="MoveUp_Click"/>
     <Button Content="下移" Click="MoveDown_Click"/>
    </StackPanel>
   </DockPanel>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="3,8,3,0">
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding BackgroundError}" Foreground="Firebrick" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding DataText}" Foreground="#555555" TextWrapping="Wrap"/>
  </StackPanel>
  <DataGrid x:Name="MonitorGrid" ItemsSource="{Binding Monitors}" AutoGenerateColumns="False"
   CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Extended" SelectionUnit="FullRow"
   IsEnabled="{Binding IsIdle}" Validation.Error="OnValidationError" EnableRowVirtualization="True"
   AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="排序" Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <Border Background="Transparent" Cursor="SizeAll" Padding="8,5" ToolTip="拖动调整目录顺序；也可用上移/下移"
      PreviewMouseLeftButtonDown="Handle_Down" PreviewMouseMove="Handle_Move" PreviewMouseLeftButtonUp="Handle_Up">
      <TextBlock Text="↕" HorizontalAlignment="Center" AutomationProperties.Name="拖动目录排序"/>
     </Border>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="状态" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <ComboBox ItemsSource="{Binding Source={StaticResource EnabledOptions}}" DisplayMemberPath="Key" SelectedValuePath="Value"
      SelectedValue="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True,NotifyOnValidationError=True}" AutomationProperties.Name="目录启用状态"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="监控目录（双击编辑）" Width="*" MinWidth="200"
     Binding="{Binding Path,UpdateSourceTrigger=LostFocus,ValidatesOnNotifyDataErrors=True,NotifyOnValidationError=True}"/>
    <DataGridTemplateColumn Header="保留天数" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <controls:DayStepper Value="{Binding RetentionDays,Mode=TwoWay,ValidatesOnNotifyDataErrors=True,NotifyOnValidationError=True}"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="删除模式" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <ComboBox ItemsSource="{Binding Source={StaticResource DeletionOptions}}" DisplayMemberPath="Key" SelectedValuePath="Value"
      SelectedValue="{Binding DeletionMode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True,NotifyOnValidationError=True}" AutomationProperties.Name="目录删除模式"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
