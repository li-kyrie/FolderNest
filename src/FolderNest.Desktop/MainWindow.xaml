<Window x:Class="FolderNest.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:FolderNest.Desktop.Controls"
 Title="FolderNest · 2.0.0" Width="1100" Height="620" MinWidth="760" MinHeight="450"
 Icon="Assets/FolderNest.ico" ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="FolderNest" FontSize="22" FontWeight="SemiBold" Margin="3,0,3,4"/>
   <WrapPanel Margin="0,4,0,8" IsEnabled="{Binding IsIdle}">
    <Button Content="添加目录" Click="Add_Click"/>
    <Button Content="启用/停用选中" Click="Toggle_Click"/>
    <Button Content="删除监控选中" Click="Remove_Click"/>
    <Button Content="扫描选中" Click="ScanSelected_Click"/>
    <Button Content="扫描全部启用" Click="ScanAll_Click"/>
    <Button Content="查看到期清单" Click="Review_Click"/>
    <Button Content="部署/选择定时任务" Click="Deploy_Click"/>
    <Button Content="卸载自动任务" Click="Uninstall_Click"/>
    <Button Content="设置" Click="Settings_Click"/>
    <Button Content="导入旧版配置" Click="Import_Click"/>
    <Button Content="查看日志" Click="Log_Click"/>
    <Button Content="刷新任务状态" Click="Tasks_Click"/>
    <Button Content="退出程序" Click="Exit_Click"/>
   </WrapPanel>
   <TextBlock Text="Ctrl 多选 · Shift 范围选择 · 从空白处拖动框选。双击路径可编辑；红框表示修改未保存。"
    Foreground="#555555" Margin="3,0,3,8" TextWrapping="Wrap"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="3,8,3,0">
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding TaskText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
   <TextBlock Text="{Binding DataText}" Foreground="#555555" TextWrapping="Wrap"/>
  </StackPanel>
  <DataGrid x:Name="MonitorGrid" ItemsSource="{Binding Monitors}" AutoGenerateColumns="False"
   CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
   IsEnabled="{Binding IsIdle}" Validation.Error="OnValidationError" EnableRowVirtualization="True">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="状态" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <ComboBox ItemsSource="{Binding Source={StaticResource EnabledOptions}}" DisplayMemberPath="Key" SelectedValuePath="Value"
      SelectedValue="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True,NotifyOnValidationError=True}" AutomationProperties.Name="目录启用状态"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="监控目录（双击编辑）" Width="*" MinWidth="200"
     Binding="{Binding Path,UpdateSourceTrigger=LostFocus,ValidatesOnNotifyDataErrors=True,NotifyOnValidationError=True}"/>
    <DataGridTemplateColumn Header="保留天数" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <controls:DayStepper Value="{Binding RetentionDays,Mode=TwoWay,ValidatesOnNotifyDataErrors=True,NotifyOnValidationError=True}"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="删除模式" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <ComboBox ItemsSource="{Binding Source={StaticResource DeletionOptions}}" DisplayMemberPath="Key" SelectedValuePath="Value"
      SelectedValue="{Binding DeletionMode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True,NotifyOnValidationError=True}" AutomationProperties.Name="目录删除模式"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="自动扫描" Width="92"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <ComboBox ItemsSource="{Binding Source={StaticResource ScheduleOptions}}" DisplayMemberPath="Key" SelectedValuePath="Value"
      SelectedValue="{Binding Scheduled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnNotifyDataErrors=True,NotifyOnValidationError=True}" AutomationProperties.Name="参与自动扫描"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="实际任务状态" Width="100" IsReadOnly="True" Binding="{Binding ScheduleText}"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
