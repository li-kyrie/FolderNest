<Window x:Class="FolderNest.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:FolderNest.Desktop.Controls"
 Title="FolderNest · 框架预览" Width="1040" Height="600" MinWidth="700" MinHeight="400"
 Icon="Assets/FolderNest.ico" ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="框架预览：目录配置和手动扫描已接通；自动提醒与清理执行待接入。"
       Background="#FFF5D6" Padding="8" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,8" IsEnabled="{Binding IsIdle}">
        <Button Content="添加目录" Click="Add_Click"/>
        <Button Content="启用/停用选中" Click="Toggle_Click"/>
        <Button Content="删除监控选中" Click="Remove_Click"/>
        <Button Content="扫描选中" Click="ScanSelected_Click"/>
        <Button Content="扫描全部启用" Click="ScanAll_Click"/>
        <Button Content="查看到期清单" Click="Review_Click"/>
        <Button Content="查看日志" Click="Log_Click"/>
        <Button Content="刷新任务状态" Click="Tasks_Click"/>
      </WrapPanel>
      <TextBlock Text="选中行后可用 Ctrl 多选、Shift 范围选择；从空白处拖动可框选。路径/天数修改通过验证后保存。"
       Foreground="#555" Margin="3,0,3,8" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="3,8,3,0">
      <TextBlock Text="{Binding Status}"/>
      <TextBlock Text="{Binding TaskText}"/>
      <TextBlock Text="{Binding LegacyTaskText}" Foreground="#666"/>
      <TextBlock Text="{Binding DataText}" Foreground="#666" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <DataGrid x:Name="MonitorGrid" ItemsSource="{Binding Monitors}" AutoGenerateColumns="False"
     CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
     IsEnabled="{Binding IsIdle}" Validation.Error="OnValidationError">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="状态" Width="85">
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
            <ComboBox ItemsSource="{Binding Source={StaticResource EnabledOptions}}" DisplayMemberPath="Key" SelectedValuePath="Value"
             SelectedValue="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/>
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="监控目录" Width="*" Binding="{Binding Path,UpdateSourceTrigger=LostFocus,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/>
        <DataGridTemplateColumn Header="天数" Width="85">
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
            <controls:DayStepper Value="{Binding RetentionDays,Mode=TwoWay,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/>
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="删除模式" Width="110">
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
            <ComboBox ItemsSource="{Binding Source={StaticResource DeletionOptions}}" DisplayMemberPath="Key" SelectedValuePath="Value"
             SelectedValue="{Binding DeletionMode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True,NotifyOnValidationError=True}"/>
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="定时任务" Width="115" IsReadOnly="True" Binding="{Binding ScheduleText}"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
